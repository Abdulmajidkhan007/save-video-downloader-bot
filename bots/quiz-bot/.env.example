# ============================================================
# Quiz Bot — sozlamalar namunasi
# Ushbu faylni ".env" deb nusxa oling va qiymatlarni to'ldiring.
# .env GitHub'ga YUKLANMAYDI (.gitignore himoyasi).
# ============================================================

# BotFather'dan olgan tokeningiz (talab qilinadi):
BOT_TOKEN=BU_YERGA_TOKEN

# Admin ID'lar (vergul bilan, kamida bittasi tavsiya).
# O'z ID'ingizni bilish uchun botga /id yuboring.
# Misol: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Majburiy obuna kanallari (vergul bilan, ixtiyoriy).
# Bo'sh qoldirsangiz — obuna talab qilinmaydi.
# Bot HAR BIR kanalda ADMIN bo'lishi shart.
# Misol: REQUIRED_CHANNELS=@kanal1,@kanal2
REQUIRED_CHANNELS=

# Railway uchun: savollar saqlanadigan papka (ixtiyoriy).
# Lokal'da o'zgartirmang. Railway'da Volume mount yo'lini bering: /app/data/questions
# Bo'sh qoldirilsa — default: data/questions/
QUESTIONS_DIR=
