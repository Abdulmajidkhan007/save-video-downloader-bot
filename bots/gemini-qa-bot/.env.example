# --- Majburiy ---
# BotFather bergan token
TELEGRAM_TOKEN=

# Google AI Studio'dan olingan kalit: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Ixtiyoriy (standart qiymatlari bor) ---
# Model nomi. Yangi nom chiqsa shu yerda o'zgartirasan.
# Variantlar: gemini-2.5-flash (tez, arzon), gemini-3.5-flash (eng yangi), gemini-2.5-pro (kuchli)
GEMINI_MODEL=gemini-2.5-flash

# Botning xulqi
SYSTEM_PROMPT=Sen foydali yordamchisan. Savollarga aniq va qisqa javob ber. Foydalanuvchi qaysi tilda yozsa, o'sha tilda javob ber.

TEMPERATURE=0.7
MAX_OUTPUT_TOKENS=1024

# Suhbat konteksti uzunligi (xabarlar soni)
HISTORY_LIMIT=10

# Rate limit
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# Admin Telegram ID (/stats uchun). Bo'sh qoldirsang, /stats yopiq bo'ladi.
ADMIN_ID=
