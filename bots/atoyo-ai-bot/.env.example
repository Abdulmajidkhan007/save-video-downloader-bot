# Telegram API ma'lumotlari — https://my.telegram.org dan olinadi
# (Bu USERBOT: BotFather tokeni emas, shaxsiy akkaunt API kaliti kerak)
API_ID=
API_HASH=

# Google Gemini kaliti — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ixtiyoriy: bir nechta Gemini kaliti (vergul bilan). Biri 429 (limit) bersa,
# kod avtomatik keyingisiga o'tadi. Berilsa GEMINI_API_KEY o'rniga shu ishlatiladi.
GEMINI_API_KEYS=

# Mahsulot postlari kuzatiladigan manba guruh ID si (masalan -1001234567890)
SOURCE_GROUP_ID=

# Tayyor kartochkalar yuboriladigan forum-guruh ID si
TARGET_GROUP_ID=

# TARGET_GROUP_ID ichidagi topic ID si (get_topic.py buni topib beradi)
AI_TOPIC_ID=
