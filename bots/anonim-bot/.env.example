# ════════════════════════════════════════════
#  MAJBURIY (.env'ga qiymat qo'ying)
# ════════════════════════════════════════════

# Telegram bot tokeni — @BotFather'dan oling
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sizning Telegram ID — @userinfobot'ga /start bosib oling
# Bu ID admin panel (/anoner), shikoyatlar, bildirishnomalar uchun ishlatiladi
ADMIN_ID=123456789


# ════════════════════════════════════════════
#  IXTIYORIY
# ════════════════════════════════════════════

# Anti-spam: bir foydalanuvchidan maks. xabar soni
# Sukut: 5 daqiqa / 30 soat
RATE_PER_MIN=5
RATE_PER_HOUR=30

# Boshlang'ich majburiy kanallar (vergul bilan ajratiladi)
# Faqat birinchi ishga tushishda hisobga olinadi — keyin /anoner orqali boshqariladi
# Misol: @kanal1,@kanal2
REQUIRED_CHANNELS=

# Ma'lumotlar saqlanadigan papka
# Lokal: bo'sh qoldiring (sukut: ./data)
# Railway: /app/data  (Volume mount path bilan moslashtiring!)
DATA_DIR=
