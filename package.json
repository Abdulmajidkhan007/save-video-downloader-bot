{
  "name": "telegram-bots-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "10 ta mustaqil Telegram bot bitta repoda. Har biri bots/<id>/ papkasida.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "list": "node tools/run.js list",
    "doctor": "node tools/run.js doctor",
    "setup": "node tools/run.js setup all",
    "install:all": "node tools/run.js install all",
    "start": "node tools/run.js start all",
    "start:all": "node tools/run.js start all --all",
    "bot": "node tools/run.js start",
    "scan": "node tools/scan-secrets.js",
    "test": "node --test tools/registry.test.js",
    "check": "npm run test && npm run scan"
  }
}
